# MCP Guardrails 环境变量配置
# 复制此文件为 .env 并修改

# ==================== 目标应用配置 ====================
# 目标 Web 应用 URL (必需)
#
# 两种使用场景:
#
#   场景A: 代理到你自己的应用 (填写任意可访问的 URL)
#     - 本机应用:  http://host.docker.internal:8080
#     - 内网应用:  http://192.168.1.100:8080
#     - 外网应用:  https://example.com
#
#   场景B: 使用内置靶机 (需要额外启动 targets/*.yml)
#     - docker-compose -f docker-compose.yml -f targets/juice-shop.yml up -d
#     - TARGET_URL=http://target-app:3000
#
TARGET_URL=http://host.docker.internal:3000

# 目标应用名称 (用于 MCP Server 标识)
TARGET_NAME=target-app

# 目标应用显示名称 (Dashboard 中显示)
TARGET_DISPLAY_NAME=Target Application

# ==================== WAF 配置 ====================
# MCP Hub (WAF1) 端口
MCP_HUB_PORT=4000

# WAF2 代理端口
WAF2_PORT=8081

# ==================== LLM 配置 ====================
# Qwen API Key (WAF2 LLM 检测需要)
QWEN_API_KEY=

# LLM 模型 (可选: qwen-turbo, qwen-plus, qwen-max)
LLM_MODEL=qwen-turbo

# ==================== 使用示例 ====================
#
# 【场景A】代理到你自己的应用
#
#   只需填写目标 URL，无论是本机、内网还是外网都一样：
#
#   TARGET_URL=http://host.docker.internal:8080   # 本机应用
#   TARGET_URL=http://192.168.1.100:8080          # 内网其他机器
#   TARGET_URL=https://example.com                # 外网网站
#
#   然后启动：
#   docker-compose up -d
#
# 【场景B】使用内置靶机
#
#   我们提供了几个常用靶机的配置：
#
#   # OWASP Juice Shop
#   docker-compose -f docker-compose.yml -f targets/juice-shop.yml up -d
#
#   # DVWA
#   docker-compose -f docker-compose.yml -f targets/dvwa.yml up -d
#
#   # WebGoat
#   docker-compose -f docker-compose.yml -f targets/webgoat.yml up -d
#
#   靶机模式下 TARGET_URL 会自动设为 http://target-app:3000
#
# ==================== 注意事项 ====================
#
# host.docker.internal 说明:
#   - 这是 Docker 提供的特殊 DNS，指向宿主机
#   - Windows/Mac Docker Desktop 原生支持
#   - Linux 需要在 docker-compose.yml 中添加 extra_hosts (已配置)
#
# HTTPS 目标:
#   - WAF2 支持代理 HTTPS 目标
#   - 确保目标证书有效，或设置 VERIFY_SSL=false
