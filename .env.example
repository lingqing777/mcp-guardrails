# MCP Guardrails 环境变量配置
# 复制此文件为 .env 并修改

# ==================== 目标应用配置 ====================
# 目标 Web 应用 URL (必需)
#
# 支持三种场景:
#   1. Docker 内置靶机:  http://target-app:3000
#   2. 宿主机本地应用:   http://host.docker.internal:3000
#   3. 外网/远程应用:    http://example.com 或 http://192.168.1.100:8080
#
TARGET_URL=http://host.docker.internal:3000

# 目标应用名称 (用于 MCP Server 标识)
TARGET_NAME=target-app

# 目标应用显示名称 (Dashboard 中显示)
TARGET_DISPLAY_NAME=Target Application

# ==================== WAF 配置 ====================
# MCP Hub (WAF1) 端口
MCP_HUB_PORT=4000

# WAF2 代理端口
WAF2_PORT=8081

# ==================== LLM 配置 ====================
# Qwen API Key (WAF2 LLM 检测需要)
QWEN_API_KEY=

# LLM 模型 (可选: qwen-turbo, qwen-plus, qwen-max)
LLM_MODEL=qwen-turbo

# ==================== 使用示例 ====================
#
# 场景1: 测试宿主机上运行的应用 (最常见)
#   你的应用运行在本机 localhost:8080
#   TARGET_URL=http://host.docker.internal:8080
#
# 场景2: 测试外网网站
#   TARGET_URL=https://example.com
#   TARGET_NAME=example-site
#
# 场景3: 测试内网其他机器
#   TARGET_URL=http://192.168.1.100:8080
#   TARGET_NAME=internal-app
#
# 场景4: 使用内置靶机 (需要配合 targets/*.yml)
#   docker-compose -f docker-compose.yml -f targets/juice-shop.yml up -d
#   TARGET_URL=http://target-app:3000
#
# ==================== 注意事项 ====================
#
# host.docker.internal 说明:
#   - 这是 Docker 提供的特殊 DNS，指向宿主机
#   - Windows/Mac Docker Desktop 原生支持
#   - Linux 需要在 docker-compose.yml 中添加 extra_hosts (已配置)
#
# HTTPS 目标:
#   - WAF2 支持代理 HTTPS 目标
#   - 确保目标证书有效，或设置 VERIFY_SSL=false
