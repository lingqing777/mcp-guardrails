# MCP Guardrails 环境变量配置
# 这些配置也可以在 Dashboard 中修改

# ==================== 核心配置 ====================
# 目标应用 URL (在 Dashboard 配置页面也可修改)
TARGET_URL=http://host.docker.internal:3000

# LLM API Key (在 Dashboard 配置页面也可修改)
QWEN_API_KEY=

# ==================== 端口配置 ====================
# MCP Hub 端口
MCP_HUB_PORT=4000

# WAF2 代理端口
WAF2_PORT=8081

# ==================== MCP 认证配置 ====================
# MCP 端点认证开关 (默认启用，设为 false 可禁用)
# MCP_AUTH_ENABLED=true

# MCP API Token (供 MCP Client 使用，如 Cursor)
# 设置后，Client 需要通过 ?token=xxx 或 Authorization: Bearer xxx 认证
# MCP_API_TOKEN=your-secret-token-here

# ==================== 可选配置 ====================
# LLM 模型 (qwen-turbo, qwen-plus, qwen-max)
LLM_MODEL=qwen-turbo
