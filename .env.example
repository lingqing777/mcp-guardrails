# MCP Guardrails 环境变量配置
# 复制此文件为 .env 并修改

# ==================== 目标应用配置 ====================
# 目标 Web 应用 URL (必需)
TARGET_URL=http://localhost:3000

# 目标应用名称 (用于 MCP Server 标识)
TARGET_NAME=target-app

# 目标应用显示名称 (Dashboard 中显示)
TARGET_DISPLAY_NAME=Target Application

# ==================== WAF 配置 ====================
# MCP Hub (WAF1) 端口
MCP_HUB_PORT=4000

# WAF2 代理端口
WAF2_PORT=8081

# ==================== LLM 配置 ====================
# Qwen API Key (WAF2 LLM 检测需要)
QWEN_API_KEY=

# LLM 模型 (可选: qwen-turbo, qwen-plus, qwen-max)
LLM_MODEL=qwen-turbo

# ==================== 可选: 外部目标应用 ====================
# 如果目标应用在外部运行 (非 Docker Compose 管理)
# 设置 EXTERNAL_TARGET=true，则不启动内置目标容器
EXTERNAL_TARGET=false

# ==================== 示例配置 ====================
#
# 1. 测试 Juice Shop:
#    TARGET_URL=http://juice-shop:3000
#    TARGET_NAME=juice-shop
#    TARGET_DISPLAY_NAME=OWASP Juice Shop
#
# 2. 测试 DVWA:
#    TARGET_URL=http://dvwa:80
#    TARGET_NAME=dvwa
#    TARGET_DISPLAY_NAME=Damn Vulnerable Web App
#
# 3. 外部应用:
#    TARGET_URL=http://192.168.1.100:8080
#    TARGET_NAME=my-app
#    EXTERNAL_TARGET=true
