{
  "mode": "full",
  "waf1": {
    "enabled": true,
    "rules": {
      "sqlInjection": true,
      "commandInjection": true,
      "xss": true,
      "pathTraversal": true,
      "sensitiveFiles": true
    }
  },
  "waf2": {
    "enabled": true,
    "upstream": "http://host.docker.internal:3000",
    "llm": {
      "provider": "qwen",
      "model": "qwen-turbo",
      "baseUrl": "http://host.docker.internal:11434/v1",
      "format": "openai",
      "providerLocality": "local",
      "privacyMode": "local_only",
      "localFirstEnabled": true,
      "apiKey": "",
      "timeout": 30000
    },
    "features": {
      "requestAnalysis": true,
      "responseAnalysis": true,
      "cache": true,
      "localAttackScore": true,
      "localFastPass": true
    }
  },
  "mcpHub": {
    "port": 4000,
    "url": "http://localhost:4000"
  }
}
