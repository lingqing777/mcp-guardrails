{
  "mode": "full",
  "waf1": {
    "enabled": true,
    "rules": {
      "sqlInjection": true,
      "commandInjection": true,
      "xss": true,
      "pathTraversal": true,
      "sensitiveFiles": true
    },
    "callChainEnabled": true,
    "dynamicPolicyEnabled": false,
    "rbacArgsEnabled": true
  },
  "waf2": {
    "enabled": true,
    "upstream": "http://host.docker.internal:3000",
    "llm": {
      "provider": "qwen",
      "model": "qwen-turbo",
      "apiKey": "",
      "timeout": 30000
    },
    "features": {
      "requestAnalysis": true,
      "responseAnalysis": true,
      "cache": true
    }
  },
  "mcpHub": {
    "port": 4000,
    "url": "http://localhost:4000"
  }
}
