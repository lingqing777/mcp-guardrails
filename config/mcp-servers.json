{
  "mcpServers": {
    "rest-api": {
      "displayName": "REST API Tools",
      "description": "HTTP tools proxied through WAF2 for security analysis",
      "transportType": "http",
      "url": "http://waf2:8081",
      "capabilities": {
        "tools": [
          {
            "name": "test_request",
            "description": "Send HTTP request to target application through WAF2 proxy",
            "inputSchema": {
              "type": "object",
              "properties": {
                "method": {
                  "type": "string",
                  "enum": ["GET", "POST", "PUT", "DELETE", "PATCH"],
                  "description": "HTTP method"
                },
                "endpoint": {
                  "type": "string",
                  "description": "API endpoint path (e.g., /api/products)"
                },
                "body": {
                  "type": "object",
                  "description": "Request body for POST/PUT/PATCH"
                },
                "headers": {
                  "type": "object",
                  "description": "Additional HTTP headers"
                }
              },
              "required": ["method", "endpoint"]
            }
          }
        ]
      }
    }
  }
}
